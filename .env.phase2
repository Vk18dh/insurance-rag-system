# ===========================================================================
# .env additions for Phase 2
# Add these to your existing .env file.
# NEVER commit .env to version control.
# ===========================================================================

# Phase 2 environment override (development | testing | staging | production)
PHASE2_ENVIRONMENT=development

# LLM provider override (gemini | offline)
PHASE2__LLM__PROVIDER=gemini

# LLM model name override
PHASE2__LLM__MODEL_NAME=gemma-3-27b-it

# LLM timeout and retries
PHASE2__LLM__TIMEOUT_SECONDS=30.0
PHASE2__LLM__MAX_RETRIES=3

# Query agent limits
PHASE2__QUERY_AGENT__MAX_QUERY_LENGTH=2000
PHASE2__QUERY_AGENT__CONFIDENCE_THRESHOLD=0.6

# Logging
PHASE2__LOGGING__LEVEL=INFO

# Security
PHASE2__SECURITY__MAX_PAYLOAD_LENGTH=10000
